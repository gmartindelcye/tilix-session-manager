# local.env — machine-specific API keys for tilix-session-manager
# Copy to config/local.env and fill in what you need.
# This file is gitignored and never committed.

# Anthropic (default — no key needed unless you want a custom org key)
# ANTHROPIC_API_KEY=sk-ant-...

# DeepSeek
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# OpenAI / ChatGPT
OPENAI_API_KEY=your-openai-api-key-here

# Qwen (Alibaba DashScope)
QWEN_API_KEY=your-qwen-api-key-here

# Gemini (Google)
GEMINI_API_KEY=your-gemini-api-key-here

# Grok (xAI)
GROK_API_KEY=your-grok-api-key-here

# Mistral
MISTRAL_API_KEY=your-mistral-api-key-here

# Custom OpenAI-compatible provider
# CUSTOM_API_KEY=your-key-here
# CUSTOM_BASE_URL=https://your-provider.com/v1
