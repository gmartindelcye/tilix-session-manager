#!/usr/bin/env bash
# tilix-session — save and restore Tilix+tmux terminal state
# Survives reboots and power failures via tmux-resurrect + layout snapshots.
#
# Usage:
#   tilix-session save       Save current tmux sessions → Tilix layout JSON
#   tilix-session restore    Restore last saved layout in Tilix
#   tilix-session status     Show saved sessions and last save time
#   tilix-session attach     Attach to (or create) the main tmux session
#   tilix-session install    Install systemd auto-save timer (runs every 10m)
#   tilix-session uninstall  Remove systemd timer

set -euo pipefail

STATE_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/tilix-session"
LAYOUT_FILE="$STATE_DIR/layout.json"
TMUX_SESSION_LIST="$STATE_DIR/tmux-sessions.txt"
SYSTEMD_DIR="$HOME/.config/systemd/user"
UNIT_NAME="tilix-session-autosave"

# ─── Helpers ────────────────────────────────────────────────────────────────

die()  { echo "ERROR: $*" >&2; exit 1; }
info() { echo "→ $*"; }

require() {
    for cmd in "$@"; do
        command -v "$cmd" &>/dev/null || die "'$cmd' not found — install it first"
    done
}

ensure_state_dir() {
    mkdir -p "$STATE_DIR"
}

# ─── Save ───────────────────────────────────────────────────────────────────

cmd_save() {
    ensure_state_dir
    require tmux python3

    info "Triggering tmux-resurrect save..."
    # tmux-resurrect save keybinding equivalent
    if tmux list-sessions &>/dev/null 2>&1; then
        tmux run-shell "$HOME/.tmux/plugins/tmux-resurrect/scripts/save.sh" 2>/dev/null || true
        info "tmux-resurrect saved"
    else
        info "No active tmux sessions — skipping resurrect save"
    fi

    info "Saving session list..."
    if tmux list-sessions -F "#{session_name}" 2>/dev/null > "$TMUX_SESSION_LIST"; then
        SESSION_COUNT=$(wc -l < "$TMUX_SESSION_LIST")
        info "Found $SESSION_COUNT tmux session(s)"
    else
        echo "" > "$TMUX_SESSION_LIST"
        info "No tmux sessions running"
    fi

    info "Building Tilix layout JSON..."
    _build_layout_json > "$LAYOUT_FILE"

    TIMESTAMP=$(date '+%Y-%m-%d %H:%M:%S')
    echo "$TIMESTAMP" > "$STATE_DIR/last-save"
    info "Saved → $LAYOUT_FILE (${TIMESTAMP})"
}

_build_layout_json() {
    # Builds a Tilix session JSON that opens one tab per tmux session.
    # Each tab attaches to its tmux session automatically.
    python3 - "$TMUX_SESSION_LIST" <<'PYEOF'
import sys, json, os

session_file = sys.argv[1]
home = os.path.expanduser("~")

sessions = []
try:
    with open(session_file) as f:
        names = [l.strip() for l in f if l.strip()]
except FileNotFoundError:
    names = []

if not names:
    # Default: single terminal at home dir
    sessions.append({
        "name": "main",
        "terminals": [{
            "command": "tmux new-session -A -s main",
            "directory": home,
            "profile": "2b7c4080-0ddd-46c5-8f23-563fd3ba789d",
            "title": "main"
        }]
    })
else:
    for name in names:
        sessions.append({
            "name": name,
            "terminals": [{
                "command": f"tmux attach-session -t {name}",
                "directory": home,
                "profile": "2b7c4080-0ddd-46c5-8f23-563fd3ba789d",
                "title": name
            }]
        })

print(json.dumps({"version": "1.0", "sessions": sessions}, indent=2))
PYEOF
}

# ─── Restore ────────────────────────────────────────────────────────────────

cmd_restore() {
    ensure_state_dir
    require tmux

    if [[ ! -f "$LAYOUT_FILE" ]]; then
        die "No saved layout found at $LAYOUT_FILE — run 'tilix-session save' first"
    fi

    info "Restoring tmux sessions via tmux-resurrect..."
    # tmux-resurrect restores sessions automatically on tmux server start
    # Force a restore if tmux is not running
    if ! tmux list-sessions &>/dev/null 2>&1; then
        tmux new-session -d -s _restore_init 2>/dev/null || true
        sleep 0.5
        tmux run-shell "$HOME/.tmux/plugins/tmux-resurrect/scripts/restore.sh" 2>/dev/null || true
        tmux kill-session -t _restore_init 2>/dev/null || true
        info "tmux-resurrect restore triggered"
    else
        info "tmux already running — sessions intact"
    fi

    LAST_SAVE=$(cat "$STATE_DIR/last-save" 2>/dev/null || echo "unknown")
    info "Opening Tilix with layout from: $LAST_SAVE"
    tilix --session="$LAYOUT_FILE" &
    disown
}

# ─── Attach ─────────────────────────────────────────────────────────────────

cmd_attach() {
    SESSION="${1:-main}"
    if tmux has-session -t "$SESSION" 2>/dev/null; then
        exec tmux attach-session -t "$SESSION"
    else
        info "Creating new tmux session '$SESSION'..."
        exec tmux new-session -s "$SESSION"
    fi
}

# ─── Status ─────────────────────────────────────────────────────────────────

cmd_status() {
    echo "─── tilix-session status ─────────────────────"
    if [[ -f "$STATE_DIR/last-save" ]]; then
        echo "Last save : $(cat "$STATE_DIR/last-save")"
    else
        echo "Last save : never"
    fi
    echo "Layout    : ${LAYOUT_FILE}"
    echo ""

    echo "─── tmux sessions ────────────────────────────"
    if tmux list-sessions 2>/dev/null; then
        :
    else
        echo "(none running)"
    fi
    echo ""

    echo "─── resurrect files ──────────────────────────"
    ls -lht "$HOME/.tmux/resurrect/" 2>/dev/null | head -5 || echo "(none)"

    echo ""
    echo "─── autosave timer ───────────────────────────"
    if systemctl --user is-active "${UNIT_NAME}.timer" &>/dev/null; then
        systemctl --user status "${UNIT_NAME}.timer" --no-pager -l | grep -E "Active|Trigger"
    else
        echo "Timer not installed (run: tilix-session install)"
    fi
}

# ─── Install systemd timer ──────────────────────────────────────────────────

cmd_install() {
    require systemctl
    mkdir -p "$SYSTEMD_DIR"

    SCRIPT_PATH="$(realpath "$0")"

    cat > "$SYSTEMD_DIR/${UNIT_NAME}.service" <<EOF
[Unit]
Description=Tilix session auto-save

[Service]
Type=oneshot
ExecStart=${SCRIPT_PATH} save
EOF

    cat > "$SYSTEMD_DIR/${UNIT_NAME}.timer" <<EOF
[Unit]
Description=Save Tilix session every 10 minutes

[Timer]
OnBootSec=2min
OnUnitActiveSec=10min
Unit=${UNIT_NAME}.service

[Install]
WantedBy=timers.target
EOF

    systemctl --user daemon-reload
    systemctl --user enable --now "${UNIT_NAME}.timer"
    info "Auto-save timer installed and enabled (every 10 min)"
    systemctl --user status "${UNIT_NAME}.timer" --no-pager
}

# ─── Uninstall ──────────────────────────────────────────────────────────────

cmd_uninstall() {
    systemctl --user disable --now "${UNIT_NAME}.timer" 2>/dev/null || true
    rm -f "$SYSTEMD_DIR/${UNIT_NAME}.service" "$SYSTEMD_DIR/${UNIT_NAME}.timer"
    systemctl --user daemon-reload
    info "Auto-save timer removed"
}

# ─── Entry point ────────────────────────────────────────────────────────────

COMMAND="${1:-help}"
shift 2>/dev/null || true

case "$COMMAND" in
    save)      cmd_save ;;
    restore)   cmd_restore ;;
    attach)    cmd_attach "$@" ;;
    status)    cmd_status ;;
    install)   cmd_install ;;
    uninstall) cmd_uninstall ;;
    help|--help|-h)
        grep '^#' "$0" | grep -E 'tilix-session|Usage|  [a-z]' | sed 's/^# //'
        ;;
    *) die "Unknown command: $COMMAND — try 'tilix-session help'" ;;
esac
