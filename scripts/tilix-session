#!/usr/bin/env bash
# tilix-session — save and restore Tilix+tmux terminal state
# Survives reboots and power failures via tmux-resurrect + layout snapshots.
#
# Usage:
#   tilix-session save       Save current tmux sessions → Tilix layout JSON
#   tilix-session restore    Restore last saved layout in Tilix
#   tilix-session status     Show saved sessions and last save time
#   tilix-session attach     Attach to (or create) the main tmux session
#   tilix-session install    Install systemd auto-save timer (runs every 10m)
#   tilix-session uninstall  Remove systemd timer

set -euo pipefail

STATE_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/tilix-session"
LAYOUT_FILE="$STATE_DIR/layout.json"
TMUX_SESSION_LIST="$STATE_DIR/tmux-sessions.txt"
SYSTEMD_DIR="$HOME/.config/systemd/user"
UNIT_NAME="tilix-session-autosave"

# ─── Helpers ────────────────────────────────────────────────────────────────

die()  { echo "ERROR: $*" >&2; exit 1; }
info() { echo "→ $*"; }
warn() { echo "⚠ $*" >&2; }

require() {
    for cmd in "$@"; do
        command -v "$cmd" &>/dev/null || die "'$cmd' not found — install it first"
    done
}

ensure_state_dir() {
    mkdir -p "$STATE_DIR"
}

# ─── Save ───────────────────────────────────────────────────────────────────

cmd_save() {
    ensure_state_dir
    require tmux python3

    info "Triggering tmux-resurrect save..."
    # tmux-resurrect save keybinding equivalent
    if tmux list-sessions &>/dev/null 2>&1; then
        tmux run-shell "$HOME/.tmux/plugins/tmux-resurrect/scripts/save.sh" 2>/dev/null || true
        info "tmux-resurrect saved"
    else
        info "No active tmux sessions — skipping resurrect save"
    fi

    info "Saving session list..."
    if tmux list-sessions -F "#{session_name}" 2>/dev/null > "$TMUX_SESSION_LIST"; then
        SESSION_COUNT=$(wc -l < "$TMUX_SESSION_LIST")
        info "Found $SESSION_COUNT tmux session(s)"
    else
        echo "" > "$TMUX_SESSION_LIST"
        info "No tmux sessions running"
    fi

    info "Building Tilix layout JSON..."
    _build_layout_json

    info "Tracking claude sessions..."
    _save_claude_sessions

    TIMESTAMP=$(date '+%Y-%m-%d %H:%M:%S')
    echo "$TIMESTAMP" > "$STATE_DIR/last-save"
    info "Saved → $LAYOUT_FILE (${TIMESTAMP})"
}

_build_layout_json() {
    # Writes a Tilix session JSON to both our state dir and Tilix's session store.
    # Tilix's -s flag looks up sessions by name in ~/.local/share/tilix/sessions/.
    local tilix_sessions_dir="${XDG_DATA_HOME:-$HOME/.local/share}/tilix/sessions"
    mkdir -p "$tilix_sessions_dir"

    python3 - "$TMUX_SESSION_LIST" "$LAYOUT_FILE" "$tilix_sessions_dir/tilix-session-restore.json" <<'PYEOF'
import sys, json, os

session_file, state_out, tilix_out = sys.argv[1], sys.argv[2], sys.argv[3]
home = os.path.expanduser("~")
profile = "2b7c4080-0ddd-46c5-8f23-563fd3ba789d"

sessions = []
try:
    with open(session_file) as f:
        names = [l.strip() for l in f if l.strip()]
except FileNotFoundError:
    names = []

if not names:
    sessions.append({
        "name": "main",
        "synchronized-input": False,
        "terminals": [{
            "profile-uuid": profile,
            "custom-title": "main",
            "command": "tmux new-session -A -s main",
            "directory": home,
            "encoding": "UTF-8"
        }]
    })
else:
    for name in names:
        sessions.append({
            "name": name,
            "synchronized-input": False,
            "terminals": [{
                "profile-uuid": profile,
                "custom-title": name,
                "command": f"tmux attach-session -t {name}",
                "directory": home,
                "encoding": "UTF-8"
            }]
        })

data = json.dumps({"version": "1.0", "sessions": sessions}, indent=2)
for path in (state_out, tilix_out):
    with open(path, "w") as f:
        f.write(data)
PYEOF
}

# ─── Claude/headroom session tracking ───────────────────────────────────────

_detect_claude_panes() {
    # Outputs "session:window.pane|cwd|launcher" per pane running claude (via headroom or directly).
    # launcher is "headroom" or "direct".
    while IFS='|' read -r target shell_pid cwd; do
        for child_pid in $(pgrep -P "$shell_pid" 2>/dev/null); do
            cmdline=$(tr '\0' ' ' < "/proc/$child_pid/cmdline" 2>/dev/null)
            if echo "$cmdline" | grep -q "headroom"; then
                printf '%s|%s|headroom\n' "$target" "$cwd"
                break
            elif echo "$cmdline" | grep -qE "/claude( |$)"; then
                printf '%s|%s|direct\n' "$target" "$cwd"
                break
            fi
        done
    done < <(tmux list-panes -a -F "#{session_name}:#{window_index}.#{pane_index}|#{pane_pid}|#{pane_current_path}" 2>/dev/null)
}

_save_claude_sessions() {
    local claude_file="$STATE_DIR/claude-sessions.json"

    if ! tmux list-sessions &>/dev/null 2>&1; then
        echo '{"version":"1.0","panes":[]}' > "$claude_file"
        info "No tmux sessions — claude session list cleared"
        return
    fi

    local tmp="$STATE_DIR/.claude-panes.tmp"
    _detect_claude_panes > "$tmp"
    local count
    count=$(grep -c '.' "$tmp" 2>/dev/null || echo 0)

    python3 - "$tmp" "$claude_file" <<'PYEOF'
import json, sys
with open(sys.argv[1]) as f:
    lines = [l.strip() for l in f if l.strip()]
panes = []
for line in lines:
    parts = line.split('|', 2)
    if len(parts) == 3:
        panes.append({"target": parts[0], "cwd": parts[1], "launcher": parts[2]})
with open(sys.argv[2], 'w') as f:
    json.dump({"version": "1.0", "panes": panes}, f, indent=2)
PYEOF
    rm -f "$tmp"
    info "claude sessions tracked: $count pane(s)"
}

_resume_claude_sessions() {
    local claude_file="$STATE_DIR/claude-sessions.json"
    [[ ! -f "$claude_file" ]] && return

    python3 - "$claude_file" <<'PYEOF'
import json, subprocess, sys, time

with open(sys.argv[1]) as f:
    panes = json.load(f).get("panes", [])

if not panes:
    sys.exit(0)

PROMPT_CHARS = ('$', '%', '❯', '➜', '>', '#', '❮')
CLAUDE_PROCS = {"python", "python3", "node"}
PROMPT_MAX_WAIT = 15

def current_command(target):
    r = subprocess.run(
        ["tmux", "list-panes", "-t", target, "-F", "#{pane_current_command}"],
        capture_output=True, text=True
    )
    if r.returncode != 0:
        return None
    return r.stdout.strip()

def wait_for_prompt(target):
    deadline = time.time() + PROMPT_MAX_WAIT
    while time.time() < deadline:
        r = subprocess.run(
            ["tmux", "capture-pane", "-p", "-t", target],
            capture_output=True, text=True
        )
        if r.returncode != 0:
            return "pane-gone"
        last = r.stdout.rstrip().split('\n')[-1].rstrip() if r.stdout.strip() else ""
        if last and any(last.endswith(c) for c in PROMPT_CHARS):
            # Confirm it's actually a shell, not stale scrollback above a running process
            cmd = current_command(target)
            if cmd is not None and cmd not in CLAUDE_PROCS:
                return "ready"
        time.sleep(0.5)
    return "timeout"

print(f"→ Resuming {len(panes)} claude session(s) (waiting for shell prompts)...")

for pane in panes:
    target, cwd = pane["target"], pane["cwd"]
    launcher = pane.get("launcher", "direct")
    cmd = "headroom wrap claude -- -c" if launcher == "headroom" else "claude -c"

    proc = current_command(target)
    if proc is None:
        print(f"  → {target} [{launcher}] ({cwd}): pane not found")
        continue
    if proc in CLAUDE_PROCS:
        print(f"  → {target} [{launcher}] ({cwd}): already running — skipped")
        continue

    state = wait_for_prompt(target)
    if state == "pane-gone":
        print(f"  → {target} [{launcher}] ({cwd}): pane not found")
        continue
    if state == "timeout":
        print(f"  → {target} [{launcher}] ({cwd}): timed out — sending anyway")
    result = subprocess.run(
        ["tmux", "send-keys", "-t", target, cmd, "Enter"],
        capture_output=True
    )
    status = "ok" if result.returncode == 0 else "send-keys failed"
    print(f"  → {target} [{launcher}] ({cwd}): {status}")
    time.sleep(0.3)
PYEOF
}

# ─── Restore ────────────────────────────────────────────────────────────────

cmd_restore() {
    ensure_state_dir
    require tmux

    if [[ ! -f "$LAYOUT_FILE" ]]; then
        die "No saved layout found at $LAYOUT_FILE — run 'tilix-session save' first"
    fi

    local resurrect_script="$HOME/.tmux/plugins/tmux-resurrect/scripts/restore.sh"

    info "Restoring tmux sessions via tmux-resurrect..."
    if ! tmux list-sessions &>/dev/null 2>&1; then
        if [[ ! -f "$resurrect_script" ]]; then
            warn "tmux-resurrect not found at $resurrect_script — skipping restore"
        else
            tmux new-session -d -s _restore_init 2>/dev/null
            # Run restore synchronously; tmux run-shell blocks until script exits
            tmux run-shell "$resurrect_script"
            # Wait up to 15s for at least one real session to appear
            local waited=0
            while [[ $waited -lt 15 ]]; do
                local real_sessions
                real_sessions=$(tmux list-sessions -F '#{session_name}' 2>/dev/null \
                    | grep -v '^_restore_init$' | wc -l)
                [[ $real_sessions -gt 0 ]] && break
                sleep 1
                (( waited++ ))
            done
            tmux kill-session -t _restore_init 2>/dev/null || true
            info "tmux-resurrect restore complete"
        fi
    else
        info "tmux already running — sessions intact"
    fi

    LAST_SAVE=$(cat "$STATE_DIR/last-save" 2>/dev/null || echo "unknown")
    info "Opening Tilix with layout from: $LAST_SAVE"
    tilix -s tilix-session-restore &
    disown

    _resume_claude_sessions
}

# ─── Attach ─────────────────────────────────────────────────────────────────

cmd_attach() {
    SESSION="${1:-main}"
    if tmux has-session -t "$SESSION" 2>/dev/null; then
        exec tmux attach-session -t "$SESSION"
    else
        info "Creating new tmux session '$SESSION'..."
        exec tmux new-session -s "$SESSION"
    fi
}

# ─── Status ─────────────────────────────────────────────────────────────────

cmd_status() {
    echo "─── tilix-session status ─────────────────────"
    if [[ -f "$STATE_DIR/last-save" ]]; then
        echo "Last save : $(cat "$STATE_DIR/last-save")"
    else
        echo "Last save : never"
    fi
    echo "Layout    : ${LAYOUT_FILE}"
    echo ""

    echo "─── tmux sessions ────────────────────────────"
    if tmux list-sessions 2>/dev/null; then
        :
    else
        echo "(none running)"
    fi
    echo ""

    echo "─── resurrect files ──────────────────────────"
    ls -lht "$HOME/.tmux/resurrect/" 2>/dev/null | head -5 || echo "(none)"

    echo ""
    echo "─── claude sessions ──────────────────────────"
    local claude_file="$STATE_DIR/claude-sessions.json"
    if [[ -f "$claude_file" ]]; then
        python3 - "$claude_file" <<'PYEOF'
import json, sys
with open(sys.argv[1]) as f:
    panes = json.load(f).get("panes", [])
if panes:
    for p in panes:
        print(f"  {p['target']:<24} {p['cwd']}")
else:
    print("  (none saved)")
PYEOF
    else
        echo "  (none saved — run: tilix-session save)"
    fi
    echo ""

    echo "─── autosave timer ───────────────────────────"
    if systemctl --user is-active "${UNIT_NAME}.timer" &>/dev/null; then
        systemctl --user status "${UNIT_NAME}.timer" --no-pager -l | grep -E "Active|Trigger"
    else
        echo "Timer not installed (run: tilix-session install)"
    fi
}

# ─── Install systemd timer ──────────────────────────────────────────────────

cmd_install() {
    require systemctl
    mkdir -p "$SYSTEMD_DIR"

    SCRIPT_PATH="$(realpath "$0")"

    cat > "$SYSTEMD_DIR/${UNIT_NAME}.service" <<EOF
[Unit]
Description=Tilix session auto-save

[Service]
Type=oneshot
ExecStart=${SCRIPT_PATH} save
EOF

    cat > "$SYSTEMD_DIR/${UNIT_NAME}.timer" <<EOF
[Unit]
Description=Save Tilix session every 10 minutes

[Timer]
OnBootSec=2min
OnUnitActiveSec=10min
Unit=${UNIT_NAME}.service

[Install]
WantedBy=timers.target
EOF

    systemctl --user daemon-reload
    systemctl --user enable --now "${UNIT_NAME}.timer"
    info "Auto-save timer installed and enabled (every 10 min)"
    systemctl --user status "${UNIT_NAME}.timer" --no-pager
}

# ─── Uninstall ──────────────────────────────────────────────────────────────

cmd_uninstall() {
    systemctl --user disable --now "${UNIT_NAME}.timer" 2>/dev/null || true
    rm -f "$SYSTEMD_DIR/${UNIT_NAME}.service" "$SYSTEMD_DIR/${UNIT_NAME}.timer"
    systemctl --user daemon-reload
    info "Auto-save timer removed"
}

# ─── Entry point ────────────────────────────────────────────────────────────

COMMAND="${1:-help}"
shift 2>/dev/null || true

case "$COMMAND" in
    save)      cmd_save ;;
    restore)   cmd_restore ;;
    attach)    cmd_attach "$@" ;;
    status)    cmd_status ;;
    install)   cmd_install ;;
    uninstall) cmd_uninstall ;;
    help|--help|-h)
        grep '^#' "$0" | grep -E 'tilix-session|Usage|  [a-z]' | sed 's/^# //'
        ;;
    *) die "Unknown command: $COMMAND — try 'tilix-session help'" ;;
esac
